# Base de datos (Supabase). Formato: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Kommo
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=

# BSP de WhatsApp
BSP_API_URL=
BSP_TOKEN=
BSP_WEBHOOK_SECRET=

# Telegram: canal de pruebas de la etapa inicial. Token de @BotFather.
TELEGRAM_BOT_TOKEN=
# polling (desarrollo local) | webhook (produccion) | off
TELEGRAM_MODO=polling
# Solo en modo webhook: el secreto que se registra con setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Notion como CRM de prueba, hasta tener acceso a Kommo.
# La base tiene que estar compartida con la integracion.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# Cuanto espera el agente antes de contestar, en segundos. Se sortea en ese
# rango por mensaje: un retraso fijo es tan detectable como contestar al
# instante. Este tiempo es tambien la ventana del buffer de mensajes.
DEMORA_RESPUESTA_MIN_SEG=60
DEMORA_RESPUESTA_MAX_SEG=120

# Horario de atencion, formato HH:MM-HH:MM, en hora de Ecuador
HORARIO_ATENCION=09:00-18:00

# El cliente es ecuatoriano: zona horaria de Quito (UTC-5) y prefijo +593.
TZ=America/Guayaquil
PAIS=EC
PREFIJO_TELEFONICO=+593

LOG_LEVEL=INFO
