# Base de datos (Supabase). Formato: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Kommo
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=

# BSP de WhatsApp
BSP_API_URL=
BSP_TOKEN=
BSP_WEBHOOK_SECRET=

# Buffer de mensajes (debounce), en segundos
VENTANA_BUFFER_SEG=6

# Horario de atencion, formato HH:MM-HH:MM, en hora de Ecuador
HORARIO_ATENCION=09:00-18:00

# El cliente es ecuatoriano: zona horaria de Quito (UTC-5) y prefijo +593.
TZ=America/Guayaquil
PAIS=EC
PREFIJO_TELEFONICO=+593

LOG_LEVEL=INFO
